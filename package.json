{
  "name": "nexora-platform-core",
  "version": "0.0.1",
  "description": "Reusable product-neutral NestJS SaaS platform core",
  "author": "",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24 <25"
  },
  "license": "UNLICENSED",
  "scripts": {
    "build": "dotenv -e .env.example -- prisma generate && nest build",
    "check:deprecated": "node scripts/check-deprecated-apis.mjs",
    "check:operations": "node scripts/check-operations-docs.mjs",
    "check:production": "ts-node --project tsconfig.json scripts/check-production-readiness.ts",
    "format": "prettier --write \"{src,test,prisma,scripts}/**/*.{ts,mjs,json}\" \".github/**/*.yml\" \"package.json\" \"tsconfig*.json\" \"nest-cli.json\" \"prisma.config.ts\" \"eslint.config.mjs\" \"compose*.yaml\" \"pnpm-workspace.yaml\"",
    "format:check": "prettier --check \"{src,test,prisma,scripts}/**/*.{ts,mjs,json}\" \".github/**/*.yml\" \"package.json\" \"tsconfig*.json\" \"nest-cli.json\" \"prisma.config.ts\" \"eslint.config.mjs\" \"compose*.yaml\" \"pnpm-workspace.yaml\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test,prisma,scripts}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,apps,libs,test,prisma,scripts}/**/*.ts\" --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit --incremental false",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:architecture": "jest --config ./test/jest-architecture.json --runInBand",
    "test:e2e": "pnpm run db:test:up && pnpm run db:push:test && dotenv -o -e .env.test -- jest --config ./test/jest-e2e.json --runInBand",
    "contract:generate": "dotenv -o -e .env.example -- ts-node --project tsconfig.json scripts/generate-openapi.ts",
    "contract:check": "dotenv -o -e .env.example -- ts-node --project tsconfig.json scripts/generate-openapi.ts --check",
    "docs:code": "compodoc -p tsconfig.doc.json -d documentation -n \"Nexora Platform Core code reference\" --disablePrivate --disableProtected --disableInternal",
    "docs:code:serve": "compodoc -p tsconfig.doc.json -d documentation -n \"Nexora Platform Core code reference\" --disablePrivate --disableProtected --disableInternal --serve",
    "docs:check": "node scripts/check-source-documentation.mjs && compodoc -p tsconfig.doc.json -d documentation -n \"Nexora Platform Core code reference\" --disablePrivate --disableProtected --disableInternal --silent",
    "update:password-blocklist": "node scripts/update-common-password-blocklist.mjs",
    "db:generate": "dotenv -e .env.example -- prisma generate",
    "db:push": "dotenv -o -e .env.example -- ts-node --project tsconfig.json scripts/assert-local-mutation-target.ts development-schema && dotenv -o -e .env.example -- prisma db push",
    "db:push:test": "dotenv -o -e .env.test -- ts-node --project tsconfig.json scripts/assert-local-mutation-target.ts test-schema && dotenv -o -e .env.test -- prisma db push",
    "db:seed": "dotenv -o -e .env.example -- prisma db seed",
    "db:seed:test": "dotenv -o -e .env.test -- prisma db seed",
    "db:dev:up": "docker compose up -d --wait",
    "db:dev:down": "docker compose down",
    "db:test:up": "docker compose -f compose.test.yaml up -d --wait",
    "db:test:down": "docker compose -f compose.test.yaml down"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.6",
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "argon2": "0.45.0",
    "dotenv": "^17.4.2",
    "redis": "^5.12.1",
    "reflect-metadata": "^0.2.2",
    "resend": "6.18.1",
    "rxjs": "^7.8.1",
    "uuid": "^11.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@compodoc/compodoc": "2.0.0",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "7.9.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
