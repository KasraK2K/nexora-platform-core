// Development source of truth: synchronize with `prisma db push`.
// Do not create migrations until the user explicitly announces the production transition.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
}

enum MailOutboxStatus {
  PENDING
  PROCESSING
  RETRY_SCHEDULED
  SENT
  FAILED
}

enum MailPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  MEMBERSHIP_INVITATION
}

model User {
  id                            String                 @id @db.Uuid
  normalizedEmail               String                 @unique(map: "users_normalized_email_key") @map("normalized_email") @db.VarChar(254)
  passwordHash                  String                 @map("password_hash") @db.VarChar(255)
  passwordUpdatedAt             DateTime               @default(now()) @map("password_updated_at") @db.Timestamptz(3)
  displayName                   String                 @map("display_name") @db.VarChar(100)
  status                        UserStatus             @default(PENDING_VERIFICATION)
  createdAt                     DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                     DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  ownedWorkspaces               Workspace[]            @relation("WorkspaceOwner")
  memberships                   Membership[]
  sessions                      Session[]
  auditLogs                     AuditLog[]
  emailVerifications            EmailVerification[]
  passwordResetTokens           PasswordResetToken[]
  sentMembershipInvitations     MembershipInvitation[] @relation("MembershipInvitationInviter")
  acceptedMembershipInvitations MembershipInvitation[] @relation("MembershipInvitationAcceptor")

  @@map("users")
}

model PasswordResetToken {
  id            String    @id @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  workspaceId   String    @map("workspace_id") @db.Uuid
  tokenHash     String    @unique(map: "password_reset_tokens_token_hash_key") @map("token_hash") @db.Char(64)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt    DateTime? @map("consumed_at") @db.Timestamptz(3)
  invalidatedAt DateTime? @map("invalidated_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user          User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt(sort: Desc)], map: "password_reset_tokens_user_id_created_at_idx")
  @@index([expiresAt], map: "password_reset_tokens_expires_at_idx")
  @@map("password_reset_tokens")
}

model EmailVerification {
  id            String    @id @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  workspaceId   String    @map("workspace_id") @db.Uuid
  tokenHash     String    @unique(map: "email_verifications_token_hash_key") @map("token_hash") @db.Char(64)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  consumedAt    DateTime? @map("consumed_at") @db.Timestamptz(3)
  invalidatedAt DateTime? @map("invalidated_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user          User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt(sort: Desc)], map: "email_verifications_user_id_created_at_idx")
  @@index([expiresAt], map: "email_verifications_expires_at_idx")
  @@map("email_verifications")
}

model Workspace {
  id                    String                 @id @db.Uuid
  ownerUserId           String                 @map("owner_user_id") @db.Uuid
  name                  String                 @db.VarChar(120)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  owner                 User                   @relation("WorkspaceOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  memberships           Membership[]
  auditLogs             AuditLog[]
  emailVerifications    EmailVerification[]
  passwordResetTokens   PasswordResetToken[]
  membershipInvitations MembershipInvitation[]
  mailOutboxMessages    MailOutboxMessage[]

  @@index([ownerUserId], map: "workspaces_owner_user_id_idx")
  @@map("workspaces")
}

model Membership {
  id          String      @id @db.Uuid
  workspaceId String      @map("workspace_id") @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  removedAt   DateTime?   @map("removed_at") @db.Timestamptz(3)
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  sessions    Session[]

  @@unique([workspaceId, userId], map: "memberships_workspace_id_user_id_key")
  @@index([workspaceId, removedAt, createdAt(sort: Desc)], map: "memberships_workspace_active_created_at_idx")
  @@index([userId], map: "memberships_user_id_idx")
  @@map("memberships")
}

model MembershipInvitation {
  id               String    @id @db.Uuid
  workspaceId      String    @map("workspace_id") @db.Uuid
  invitedByUserId  String    @map("invited_by_user_id") @db.Uuid
  acceptedByUserId String?   @map("accepted_by_user_id") @db.Uuid
  normalizedEmail  String    @map("normalized_email") @db.VarChar(254)
  tokenHash        String    @unique(map: "membership_invitations_token_hash_key") @map("token_hash") @db.Char(64)
  activeKey        String?   @unique(map: "membership_invitations_active_key_key") @map("active_key") @db.Char(64)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt       DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  invitedBy        User      @relation("MembershipInvitationInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  acceptedBy       User?     @relation("MembershipInvitationAcceptor", fields: [acceptedByUserId], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt(sort: Desc)], map: "membership_invitations_workspace_id_created_at_idx")
  @@index([workspaceId, normalizedEmail, expiresAt], map: "membership_invitations_workspace_email_expires_at_idx")
  @@map("membership_invitations")
}

model MailOutboxMessage {
  id               String           @id @db.Uuid
  workspaceId      String           @map("workspace_id") @db.Uuid
  purpose          MailPurpose
  idempotencyKey   String           @unique(map: "mail_outbox_messages_idempotency_key_key") @map("idempotency_key") @db.VarChar(160)
  messageId        String           @unique(map: "mail_outbox_messages_message_id_key") @map("message_id") @db.VarChar(320)
  encryptedPayload String           @map("encrypted_payload") @db.Text
  correlationId    String           @map("correlation_id") @db.VarChar(64)
  status           MailOutboxStatus @default(PENDING)
  attemptCount     Int              @default(0) @map("attempt_count")
  nextAttemptAt    DateTime         @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lockedUntil      DateTime?        @map("locked_until") @db.Timestamptz(3)
  lastAttemptAt    DateTime?        @map("last_attempt_at") @db.Timestamptz(3)
  sentAt           DateTime?        @map("sent_at") @db.Timestamptz(3)
  failedAt         DateTime?        @map("failed_at") @db.Timestamptz(3)
  expiresAt        DateTime         @map("expires_at") @db.Timestamptz(3)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  workspace        Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt], map: "mail_outbox_messages_status_next_attempt_at_idx")
  @@index([workspaceId, createdAt(sort: Desc)], map: "mail_outbox_messages_workspace_created_at_idx")
  @@index([expiresAt], map: "mail_outbox_messages_expires_at_idx")
  @@map("mail_outbox_messages")
}

model Session {
  id          String     @id @db.Uuid
  tokenHash   String     @unique(map: "sessions_token_hash_key") @map("token_hash") @db.Char(64)
  userId      String     @map("user_id") @db.Uuid
  workspaceId String     @map("workspace_id") @db.Uuid
  expiresAt   DateTime   @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime?  @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  user        User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  membership  Membership @relation(fields: [workspaceId, userId], references: [workspaceId, userId], onDelete: Restrict)

  @@index([userId, expiresAt], map: "sessions_user_id_expires_at_idx")
  @@index([workspaceId, expiresAt], map: "sessions_workspace_id_expires_at_idx")
  @@map("sessions")
}

model AuditLog {
  id          String    @id @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  actorUserId String    @map("actor_user_id") @db.Uuid
  action      String    @db.VarChar(100)
  resourceId  String    @map("resource_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  actor       User      @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt(sort: Desc)], map: "audit_logs_workspace_id_created_at_idx")
  @@map("audit_logs")
}
