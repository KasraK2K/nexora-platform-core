# Template only. Every placeholder must be replaced through the selected secret/configuration system.
NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>?sslmode=verify-full
REDIS_URL=rediss://:<password>@<host>:6379
APP_ORIGINS=https://<application-origin>
TRUST_PROXY=<exact-proxy-ip-or-cidr>
RATE_LIMIT_KEY_SECRET=<minimum-32-character-secret>
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
API_DOCS_ENABLED=false
METRICS_ENABLED=false
METRICS_BEARER_TOKEN=
PWNED_PASSWORDS_ENABLED=true
PWNED_PASSWORDS_TIMEOUT_MS=1500
SESSION_TTL_SECONDS=604800
EMAIL_VERIFICATION_TTL_SECONDS=86400
EMAIL_VERIFICATION_URL=https://<application-origin>/verify-email
PASSWORD_RESET_TTL_SECONDS=3600
PASSWORD_RESET_URL=https://<application-origin>/reset-password
MEMBERSHIP_INVITATION_TTL_SECONDS=86400
MEMBERSHIP_INVITATION_URL=https://<application-origin>/accept-invitation
EMAIL_FROM=<approved-sender>
EMAIL_MESSAGE_ID_DOMAIN=<approved-mail-domain>
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=<smtp-user-or-empty-for-approved-nonauthenticated-relay>
SMTP_PASSWORD=<smtp-password-or-empty-for-approved-nonauthenticated-relay>
SMTP_TIMEOUT_MS=5000
MAIL_OUTBOX_ENCRYPTION_KEY=<base64-encoded-32-byte-key>
MAIL_WORKER_ENABLED=true
MAIL_MAX_ATTEMPTS=5
MAIL_RETRY_BASE_MS=1000
MAIL_RETRY_MAX_MS=300000
MAIL_POLL_INTERVAL_MS=1000
MAIL_CLAIM_TTL_MS=30000
DEPENDENCY_HEALTH_TIMEOUT_MS=2000
SHUTDOWN_TIMEOUT_MS=10000
